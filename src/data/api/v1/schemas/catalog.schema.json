{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://veggie.farm/data/api/v1/schemas/catalog.schema.json",
  "title": "veggie.farm static data API catalog",
  "type": "object",
  "required": ["title", "version", "updated", "storageProfile", "implementationProfile", "standards", "links"],
  "properties": {
    "title": {"type": "string"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "updated": {"type": "string", "format": "date"},
    "storageProfile": {"const": "static-json"},
    "implementationProfile": {"const": "client-query-adapter"},
    "standards": {"type": "array", "minItems": 3},
    "links": {"type": "array", "minItems": 1}
  }
}
